# Dify API 基址（本地自托管）
# 源码：/Users/caofan/dify ，Nginx 映射 80 端口
DIFY_API_URL=http://127.0.0.1/v1

# 聊天助手 API Key（Dify 应用 → 访问 API → API 密钥）
DIFY_API_KEY=

# 知识库 API Key（知识库 → 设置 → API）
# 若不填，默认复用 DIFY_API_KEY（仅当你的 Key 同时能调 Dataset API 时才可行）
DIFY_DATASET_API_KEY=

# 知识库 ID（浏览器打开知识库，URL 中的 UUID）
DIFY_DATASET_ID=

# 终端用户标识，用于 Dify 会话隔离
DIFY_USER=docflow-demo

# 拒答阈值：最高引用相似度低于该值则展示拒答卡
# 高质量向量索引用 0.6；经济索引（关键词）命中分大约 0.15，建议 0.12
REFUSAL_SCORE_THRESHOLD=0.6

# 文档索引方式：high_quality 需要已配置 Embedding 模型；否则改为 economy
DIFY_INDEXING_TECHNIQUE=high_quality
